ANTHROPIC_API_KEY=your-api-key-here

# Optional: also write translated copies of the reports (report.<language>.md).
# The analysis itself always runs in English.
# REPORT_TRANSLATION=Lithuanian     # any language: Lithuanian, German, Japanese, ...
# TRANSLATE_LENS_REPORTS=true

# Experiments, compared in the eval before becoming defaults:
# ANALYSIS_MODEL=claude-sonnet-5    # default claude-sonnet-4-6
# THINKING=adaptive                 # default off
# ANALYSIS_EFFORT=low               # default unset: each model's own default
# LENS_SELECTION=on                 # default off: skip lenses that do not fit the idea, add domain lenses
# EXTRA_LENSES=unit_economics       # default none: defined lenses to run in addition
# WEB_SEARCH=on                     # default off: web search for Reality Auditor and Legal Counsel
